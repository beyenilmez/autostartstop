{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
      "config:recommended",
      "helpers:pinGitHubActionDigests",
      ":configMigration"
    ],
  
    "ignorePaths": ["docs/requirements-lock.txt"],
    "packageRules": [
      {
        "description": "Docs Python tooling: show on dashboard only, no automatic PRs",
        "matchManagers": ["pip_requirements", "pyenv"],
        "dependencyDashboardApproval": true
      },
      {
        "description": "Group non-major Gradle library updates",
        "matchFileNames": ["gradle/libs.versions.toml"],
        "matchUpdateTypes": ["minor", "patch"],
        "groupName": "Gradle dependencies (non-major)"
      },
      {
        "description": "Group all GitHub Actions updates into a single PR",
        "matchManagers": ["github-actions"],
        "groupName": "GitHub Actions"
      }
    ],
    "customManagers": [
      {
        "description": "Keep version table in docs/src/credits.md in sync with Gradle deps",
        "customType": "regex",
        "managerFilePatterns": ["/^docs/src/credits\\.md$/"],
        "matchStrings": [
          "<!--\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*-->[^\\n]*\\n[^|]*\\|[^|]*\\|\\s*(?<currentValue>[^\\s|]+)\\s*\\|"
        ]
      }
    ]
  }
  
